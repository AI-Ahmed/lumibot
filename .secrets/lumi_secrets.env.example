##### WARNING: THIS IS AN EXAMPLE FILE — DO NOT ADD YOUR REAL KEYS HERE, THEY WILL BE CHECKED IN TO GIT #####
# Copy this file to .secrets/lumi_secrets.env and fill in your values.
# This file is NOT stored in GitHub and should only be stored locally.

# ──────────────────────────────────────────────────────────────
# Alpaca (live/paper trading and backtesting data)
# ──────────────────────────────────────────────────────────────
# For unit tests
ALPACA_TEST_API_KEY='<your key here>'
ALPACA_TEST_API_SECRET='<your key here>'

# For live or paper trading (set ALPACA_IS_PAPER=true for paper)
ALPACA_API_KEY='<your key here>'
ALPACA_API_SECRET='<your key here>'
ALPACA_IS_PAPER=true

# ──────────────────────────────────────────────────────────────
# Interactive Brokers (TWS or IB Gateway)
# ──────────────────────────────────────────────────────────────
IB_PORT=7497
IB_CLIENT_ID=1
# IB_HOST=127.0.0.1

# Interactive Brokers REST API (optional)
# IB_REST_ACCOUNT_NUMBER='<your account here>'
# IB_REST_ACCESS_TOKEN='<your token here>'

# ──────────────────────────────────────────────────────────────
# AI agent providers (optional — only needed for AI trading agents)
# ──────────────────────────────────────────────────────────────
# GEMINI_API_KEY='<your key here>'
# OPENAI_API_KEY='<your key here>'
# ANTHROPIC_API_KEY='<your key here>'
# XAI_API_KEY='<your key here>'

# ──────────────────────────────────────────────────────────────
# Lumibot configuration
# ──────────────────────────────────────────────────────────────
# BACKTESTING_DATA_SOURCE=yahoo   # yahoo | alpaca | ibkr (default: yahoo)
# BACKTESTING_START=2020-01-01
# BACKTESTING_END=2024-12-31
